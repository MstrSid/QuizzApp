<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".MiniTestsFragment">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        app:cardBackgroundColor="#FFF"
        app:cardCornerRadius="8dp"
        app:cardElevation="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/cv_text_view_hello"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF"
                android:gravity="center"
                android:text="@string/txt_self_check"
                android:textColor="@color/dark_grey"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cv_text_view_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF"
                android:gravity="center"
                android:text="@string/txt_self_control"
                android:textColor="#757575"
                android:textSize="16sp" />

                <Button
                    android:id="@+id/btn_start_theory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rect_rounded_button"
                    android:text="@string/txt_questions_theory"
                    android:textColor="@color/white"
                    android:textSize="18sp">
                </Button>

                <Button
                    android:id="@+id/btn_start_tasks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rect_rounded_button"
                    android:text="@string/txt_tasks"
                    android:textColor="@color/white"
                    android:textSize="18sp">

                </Button>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>